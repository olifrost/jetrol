---
import Layout from "../layouts/Layout.astro";
import { ChevronDown } from "lucide-astro";
import JetTaxCalculator from "../components/JetTaxCalculator.tsx";

import possibleLogo from "../assets/logos/Possible_Logo_WebsiteLogo.jpg";
import seriousPeopleLogo from "../assets/logos/SP-Logo.png";
import ffukLogo from "../assets/logos/FFUK_round_logo_d-blue.png";
import galbaLogo from "../assets/logos/1 galba logo teal 4.png";
import jetcollectorsLogo from "../assets/JetCollectors_logo-1.svg";
import jetrolLogoWhite from "../assets/jetrol/Jetrol-Logo-White.svg";

const homeHref = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<Layout
    title="Jet Collectors - Tax Private Jets, Fund Public Services"
    description="A pilot-led coalition calling for fair taxation on private jet flights to and from the UK. Join the campaign to raise almost £2bn every year for essential services."
>
    <main class="bg-zinc-900 min-h-screen">
        <!-- Navigation -->
        <nav
            class="border-b border-zinc-800 sticky top-0 z-50 backdrop-blur-sm bg-zinc-950/95"
        >
            <div class="max-w-7xl mx-auto px-6 lg:px-8">
                <div class="flex items-center justify-between h-20">
                    <div class="flex items-center">
                        <a href="#" class="transition-opacity hover:opacity-80">
                            <img
                                src={jetcollectorsLogo.src}
                                alt="Jet Collectors"
                                class="h-12 w-auto invert"
                            />
                        </a>
                    </div>
                    <div class="hidden md:flex items-center space-x-8">
                        <a
                            href="#about"
                            class="text-zinc-400 hover:text-white transition-colors font-medium"
                            >About</a
                        >
                        <a
                            href="#petition"
                            class="text-zinc-400 hover:text-white transition-colors font-medium"
                            >Petition</a
                        >
                        <a
                            href="#faq"
                            class="text-zinc-400 hover:text-white transition-colors font-medium"
                            >FAQ</a
                        >
                        <a
                            href={homeHref}
                            class="text-zinc-400 hover:text-white transition-colors font-medium"
                            >Jetrol</a
                        >
                        <a
                            href="#coalition"
                            class="text-zinc-400 hover:text-white transition-colors font-medium"
                            >Coalition</a
                        >
                    </div>
                </div>
            </div>
        </nav>

        <!-- Hero Section -->
        <section id="about" class="py-32 sm:py-40 lg:py-48 px-6 lg:px-8">
            <div class="max-w-6xl mx-auto text-center">
                <h1
                    class="text-5xl sm:text-6xl lg:text-7xl text-white max-w-5xl mx-auto mb-3"
                >
                    <strong>You Pay Fuel Duty.</strong>
                    <br />Why Don't Billionaires?
                </h1>
                <p class="text-2xl sm:text-3xl text-zinc-300 max-w-4xl mx-auto">
                    <strong>Jet Collectors</strong> is a pilot-led coalition calling
                    for fair taxation on private jet flights to and from the UK
                </p>
            </div>
        </section>

        <!-- Divider -->
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <div class="border-t border-zinc-800"></div>
        </div>

        <!-- Petition Section -->
        <section id="petition" class="py-20 px-6 lg:px-8">
            <div class="max-w-4xl mx-auto text-center">
                <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">
                    Tax Private Jets, Fund Public Services
                </h2>
                <p
                    class="text-xl text-zinc-400 leading-relaxed mb-4 max-w-2xl mx-auto"
                >
                    Right now, a drive to the shops incurs more fuel duty than a
                    billionaire taking a jet to Dubai.
                </p>
                <p
                    class="text-xl text-zinc-400 leading-relaxed mb-4 max-w-2xl mx-auto"
                >
                    We’re asking Rachel Reeves to tax the fuel on private jets
                    so we can fund the important things on the ground.
                </p>
                <p
                    class="text-xl text-zinc-400 leading-relaxed mb-8 max-w-2xl mx-auto"
                >
                    Fairer taxation could raise <strong class="text-white"
                        >almost £2bn every year</strong
                    > for essential services.
                </p>
                <a
                    href="https://action.wearepossible.org/page/180469/action/1"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 bg-brand-pink hover:bg-pink-600 text-white font-bold py-5 px-10 rounded-lg transition-all transform hover:scale-105 text-lg shadow-lg shadow-brand-pink/30"
                >
                    Join the campaign
                </a>
            </div>
        </section>

        <!-- Divider -->
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <div class="border-t border-zinc-800"></div>
        </div>

        <!-- Tax Calculator Section -->
        <JetTaxCalculator client:load />

        <!-- Divider -->
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <div class="border-t border-zinc-800"></div>
        </div>

        <!-- FAQ Section -->
        <section id="faq" class="py-20 px-6 lg:px-8">
            <div class="max-w-4xl mx-auto">
                <h2
                    class="text-3xl sm:text-4xl font-bold text-center mb-12 text-white"
                >
                    Frequently Asked Questions
                </h2>
                <div class="space-y-4">
                    <!-- FAQ 1 -->
                    <details
                        class="group bg-white/5 rounded-lg overflow-hidden border border-zinc-800 hover:border-brand-pink/50 transition-colors"
                    >
                        <summary
                            class="flex items-center justify-between cursor-pointer p-6 font-semibold text-white hover:bg-white/5 transition-colors"
                        >
                            <span class="text-lg"
                                >What do you want Rachel Reeves to do?</span
                            >
                            <ChevronDown
                                class="w-5 h-5 text-pink-400 group-open:rotate-180 transition-transform shrink-0 ml-4"
                            />
                        </summary>
                        <div class="px-6 pb-6 text-zinc-400 leading-relaxed">
                            <p>
                                We're asking Rachel Reeves to tax the fuel on
                                private jets so we can fund the important things
                                on the ground. While ordinary drivers are taxed
                                at the pump, private jet fuel remains entirely
                                duty-free. It's time to close this loophole.
                            </p>
                        </div>
                    </details>

                    <!-- FAQ 2 -->
                    <details
                        class="group bg-white/5 rounded-lg overflow-hidden border border-zinc-800 hover:border-brand-pink/50 transition-colors"
                    >
                        <summary
                            class="flex items-center justify-between cursor-pointer p-6 font-semibold text-white hover:bg-white/5 transition-colors"
                        >
                            <span class="text-lg">Who are Jet Collectors?</span>
                            <ChevronDown
                                class="w-5 h-5 text-pink-400 group-open:rotate-180 transition-transform shrink-0 ml-4"
                            />
                        </summary>
                        <div class="px-6 pb-6 text-zinc-400 leading-relaxed">
                            <p>
                                Jet Collectors is a new pilot-led coalition of
                                aviation and climate campaigners calling for
                                fair taxes on private jet flights to and from
                                the UK. Jet Collector members include <a
                                    href="https://www.wearepossible.org"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-pink-400 hover:text-pink-300 transition-colors underline"
                                    >Possible</a
                                >, <a
                                    href="https://flightfree.co.uk"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-pink-400 hover:text-pink-300 transition-colors underline"
                                    >Flight Free UK</a
                                >, <a
                                    href="https://seriouspeople.co"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-pink-400 hover:text-pink-300 transition-colors underline"
                                    >Serious People</a
                                >, and <a
                                    href="https://www.galba.uk"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-pink-400 hover:text-pink-300 transition-colors underline"
                                    >Galba</a
                                >.
                            </p>
                        </div>
                    </details>

                    <!-- FAQ 3 -->
                    <details
                        class="group bg-white/5 rounded-lg overflow-hidden border border-zinc-800 hover:border-brand-pink/50 transition-colors"
                    >
                        <summary
                            class="flex items-center justify-between cursor-pointer p-6 font-semibold text-white hover:bg-white/5 transition-colors"
                        >
                            <span class="text-lg"
                                >How much could taxing private jet fuel raise?</span
                            >
                            <ChevronDown
                                class="w-5 h-5 text-pink-400 group-open:rotate-180 transition-transform shrink-0 ml-4"
                            />
                        </summary>
                        <div class="px-6 pb-6 text-zinc-400 leading-relaxed">
                            <p class="mb-3">
                                If UK private jets were taxed fairly, Rachel
                                Reeves could raise an estimated <strong
                                    class="text-pink-400"
                                    >Almost £2bn every year</strong
                                > for essential public services and investment in
                                clean transport.
                            </p>
                            <p>
                                Currently, private jets in the UK pay 0% tax on
                                fuel (fuel duty), while UK motorists pay £0.5295
                                per litre for unleaded petrol and diesel. With
                                the UK now the private jet capital of Europe,
                                this is a cash cow that has been hiding in plain
                                sight.
                            </p>
                            <p class="text-xs text-zinc-500 mt-3">
                                Data analysis done by International Council on
                                Clean Transportation based on their 2023 global
                                private jet emission inventory
                            </p>
                        </div>
                    </details>

                    <!-- FAQ 4 -->
                    <details
                        class="group bg-white/5 rounded-lg overflow-hidden border border-zinc-800 hover:border-brand-pink/50 transition-colors"
                    >
                        <summary
                            class="flex items-center justify-between cursor-pointer p-6 font-semibold text-white hover:bg-white/5 transition-colors"
                        >
                            <span class="text-lg"
                                >What's so bad about private jets?</span
                            >
                            <ChevronDown
                                class="w-5 h-5 text-pink-400 group-open:rotate-180 transition-transform shrink-0 ml-4"
                            />
                        </summary>
                        <div class="px-6 pb-6 text-zinc-400 leading-relaxed">
                            <p class="mb-3">
                                Private jets are extremely polluting. A UK
                                motorist would have to drive once around the
                                equator to match the carbon emissions of the
                                UK's most popular private jet route – from
                                Farnborough to Nice-Côte d'Azur.
                            </p>
                            <p>
                                In terms of environmental impact, private jet
                                travel is 15 times more polluting than
                                commercial jet travel per passenger.
                            </p>
                            <p class="text-xs text-zinc-500 mt-3">
                                Data analysis done by International Council on
                                Clean Transportation based on their 2023 global
                                private jet emission inventory
                            </p>
                        </div>
                    </details>

                    <!-- FAQ 5 -->
                    <details
                        class="group bg-white/5 rounded-lg overflow-hidden border border-zinc-800 hover:border-brand-pink/50 transition-colors"
                    >
                        <summary
                            class="flex items-center justify-between cursor-pointer p-6 font-semibold text-white hover:bg-white/5 transition-colors"
                        >
                            <span class="text-lg"
                                >What about jobs in the private jet industry?</span
                            >
                            <ChevronDown
                                class="w-5 h-5 text-pink-400 group-open:rotate-180 transition-transform shrink-0 ml-4"
                            />
                        </summary>
                        <div class="px-6 pb-6 text-zinc-400 leading-relaxed">
                            <p>
                                Aviation workers understand that the pollution
                                from air travel will need to be priced higher.
                                We want that to be done in a fair and
                                progressive way that encourages the industry to
                                adapt while benefiting workers. Private jet
                                airports are perfectly placed to become zero
                                carbon aircraft hubs – and generate a new
                                exciting industry for the UK – with associated
                                jobs and technology development.
                            </p>
                        </div>
                    </details>

                    <!-- FAQ 6 -->
                    <details
                        class="group bg-white/5 rounded-lg overflow-hidden border border-zinc-800 hover:border-brand-pink/50 transition-colors"
                    >
                        <summary
                            class="flex items-center justify-between cursor-pointer p-6 font-semibold text-white hover:bg-white/5 transition-colors"
                        >
                            <span class="text-lg"
                                >Are other countries doing anything about this?</span
                            >
                            <ChevronDown
                                class="w-5 h-5 text-pink-400 group-open:rotate-180 transition-transform shrink-0 ml-4"
                            />
                        </summary>
                        <div class="px-6 pb-6 text-zinc-400 leading-relaxed">
                            <p class="mb-3">
                                Yes. France already applies a solidarity levy to
                                air tickets to help fund healthcare abroad. Nine
                                countries, including France and Spain, have
                                joined the Solidarity Levies on Premium Flyers
                                coalition of the willing.
                            </p>
                            <p>
                                These countries have committed to applying a
                                solidarity levy on private jet fuel, and first-
                                and business-class tickets in order to raise
                                vital funds for public healthcare, schools,
                                transport, infrastructure, and climate
                                adaptation & resilience. The UK is not yet part
                                of this coalition, but has a key moment to join
                                at the upcoming COP30 climate conference in
                                Belém.
                            </p>
                        </div>
                    </details>

                    <!-- FAQ 7 -->
                    <details
                        class="group bg-white/5 rounded-lg overflow-hidden border border-zinc-800 hover:border-brand-pink/50 transition-colors"
                    >
                        <summary
                            class="flex items-center justify-between cursor-pointer p-6 font-semibold text-white hover:bg-white/5 transition-colors"
                        >
                            <span class="text-lg"
                                >What can ordinary people do about private jets?</span
                            >
                            <ChevronDown
                                class="w-5 h-5 text-pink-400 group-open:rotate-180 transition-transform shrink-0 ml-4"
                            />
                        </summary>
                        <div class="px-6 pb-6 text-zinc-400 leading-relaxed">
                            <p class="mb-4">
                                Right now, Rachel Reeves is wondering where to
                                find money to fund our public services.
                                Meanwhile, private jets are flying above our
                                heads right now, paying nothing in fuel duty.
                            </p>
                            <p>
                                You can take action by writing to your MP and
                                signing the petition calling for fairer taxes on
                                private jet flights. We're asking her to raise
                                taxes on those with the broadest shoulders – and
                                nothing says "I have money to spare" more than
                                travelling by private jet.
                            </p>
                        </div>
                    </details>
                </div>
            </div>
        </section>

        <!-- Divider -->
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <div class="border-t border-zinc-800"></div>
        </div>

        <!-- Campaigns Section -->
        <section id="campaigns" class="py-20 px-6 lg:px-8">
            <div class="max-w-5xl mx-auto">
                <h2
                    class="text-2xl sm:text-3xl font-bold text-center mb-12 text-white"
                >
                    How can I avoid paying fuel duty?
                </h2>
                <div class="flex justify-center">
                    <a
                        href={homeHref}
                        class="group bg-white/5 rounded-lg overflow-hidden border border-zinc-800 hover:border-[#F16423]/60 transition-all p-8 max-w-md flex-1"
                    >
                        <div class="flex items-center justify-center mb-4 h-32">
                            <img
                                src={jetrolLogoWhite.src}
                                alt="Jetrol"
                                class="h-20 w-auto"
                            />
                        </div>
                        <p
                            class="text-center text-zinc-400 group-hover:text-white transition-colors"
                        >
                            Duty-free petrol for any winged vehicle
                        </p>
                    </a>
                </div>
            </div>
        </section>

        <!-- Divider -->
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <div class="border-t border-zinc-800"></div>
        </div>

        <!-- Coalition Members -->
        <section id="coalition" class="py-20 px-6 lg:px-8 bg-white">
            <div class="max-w-5xl mx-auto">
                <h2
                    class="text-2xl sm:text-3xl font-bold text-center mb-12 text-gray-900"
                >
                    Coalition Members
                </h2>
                <div
                    class="grid grid-cols-2 md:grid-cols-4 gap-8 items-center justify-items-center"
                >
                    <a
                        href="https://www.wearepossible.org"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center justify-center hover:opacity-80 transition-opacity"
                    >
                        <img
                            src={possibleLogo.src}
                            alt="Possible"
                            class="h-24 w-auto object-contain"
                        />
                    </a>
                    <a
                        href="https://flightfree.co.uk"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center justify-center hover:opacity-80 transition-opacity"
                    >
                        <img
                            src={ffukLogo.src}
                            alt="Flight Free UK"
                            class="h-24 w-auto object-contain"
                        />
                    </a>
                    <a
                        href="https://seriouspeople.co"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center justify-center hover:opacity-80 transition-opacity"
                    >
                        <img
                            src={seriousPeopleLogo.src}
                            alt="Serious People"
                            class="h-24 w-auto object-contain"
                        />
                    </a>
                    <a
                        href="https://www.galba.uk"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center justify-center hover:opacity-80 transition-opacity"
                    >
                        <img
                            src={galbaLogo.src}
                            alt="Galba"
                            class="h-24 w-auto object-contain"
                        />
                    </a>
                </div>
            </div>
        </section>

        <!-- Divider -->
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <div class="border-t border-zinc-800"></div>
        </div>

        <!-- Footer -->
        <footer class="py-12 px-6 lg:px-8 bg-zinc-900">
            <div class="max-w-7xl mx-auto">
                <div class="flex flex-col items-center text-center space-y-4">
                    <a
                        href="#"
                        class="inline-block transition-opacity"
                    >
                        <img
                            src={jetcollectorsLogo.src}
                            alt="Jet Collectors"
                            class="h-16 w-auto brightness-0 invert"
                        />
                    </a>
                </div>
            </div>
        </footer>
    </main>
</Layout>
