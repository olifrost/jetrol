---
import Layout from "../layouts/Layout.astro";
import { ChevronDown } from "lucide-astro";
import JetTaxCalculator from "../components/JetTaxCalculator.tsx";
import { lm } from "../content/learnmore";

import jetcollectorsLogo from "../assets/JetCollectors_logo-1.svg";
import jetrolLogoWhite from "../assets/jetrol/Jetrol-Logo-White.svg";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeHref = `${base}/`;
const learnMoreHref = `${base}/learnmore`;
---

<Layout
  title={lm.meta.title}
  description={lm.meta.description}
>
  <main class="bg-zinc-900 min-h-screen">
    <!-- Navigation -->
    <nav class="border-b border-zinc-800 sticky top-0 z-50 backdrop-blur-sm bg-zinc-950/95">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
          <div class="flex items-center">
            <a href={learnMoreHref} class="transition-opacity hover:opacity-80">
              <img
                src={jetcollectorsLogo.src}
                alt="Jet Collectors"
                class="h-12 w-auto invert"
              />
            </a>
          </div>
          <div class="hidden md:flex items-center space-x-8">
            <a href="#about" class="text-zinc-400 hover:text-white transition-colors font-medium">
              {lm.nav.about}
            </a>
            <a href="#petition" class="text-zinc-400 hover:text-white transition-colors font-medium">
              {lm.nav.petition}
            </a>
            <a href="#faq" class="text-zinc-400 hover:text-white transition-colors font-medium">
              {lm.nav.faq}
            </a>
            <a href={homeHref} class="text-zinc-400 hover:text-white transition-colors font-medium">
              {lm.nav.homeLabel}
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section id="about" class="py-24 sm:py-28 lg:py-32 px-6 lg:px-8">
      <div class="max-w-6xl mx-auto text-center">
        <h1 class="text-5xl sm:text-6xl lg:text-7xl text-white max-w-5xl mx-auto mb-3">
          <strong>{lm.hero.headlineStrong}</strong>
          <br />
          {lm.hero.headlineRest}
        </h1>
        <p class="text-2xl sm:text-3xl text-zinc-300 max-w-4xl mx-auto">
          {lm.hero.sub}
        </p>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="border-t border-zinc-800"></div>
    </div>

    <!-- Petition Section -->
    <section id="petition" class="py-20 px-6 lg:px-8">
      <div class="max-w-5xl mx-auto text-center">
        <h2 class="text-6xl sm:text-4xl font-bold text-white mb-6">
          {lm.petition.heading}
        </h2>
        <p class="text-xl text-zinc-400 leading-relaxed mb-4 max-w-6xl mx-auto">
          {lm.petition.body1}
        </p>
        <p class="text-xl text-zinc-400 leading-relaxed mb-4 max-w-6xl mx-auto">
          {lm.petition.body2}
        </p>
        <p class="text-xl text-zinc-400 leading-relaxed mb-4 max-w-6xl mx-auto">
          {lm.petition.body3}
        </p>
        <p class="text-xl text-zinc-400 leading-relaxed mb-4 max-w-6xl mx-auto">
          {lm.petition.body4Before}
          <a
            href={lm.petition.body4Href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-pink-400 hover:text-pink-300 underline"
          >
            {lm.petition.body4LinkText}
          </a>
          {lm.petition.body4After}
        </p>
        <p class="text-xl text-zinc-400 leading-relaxed mb-8 max-w-6xl mx-auto">
          {lm.petition.body5Before}
          <a
            href={lm.petition.body5Href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-pink-400 hover:text-pink-300 underline"
          >
            {lm.petition.body5LinkText}
          </a>
          {lm.petition.body5After}
        </p>
        <a
          href={lm.petition.ctaHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-brand-pink hover:bg-pink-600 text-white font-bold py-5 px-10 rounded-lg transition-all transform hover:scale-105 text-lg shadow-lg shadow-brand-pink/30"
        >
          {lm.petition.cta}
        </a>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="border-t border-zinc-800"></div>
    </div>

    <!-- Tax Calculator -->
      <JetTaxCalculator
        client:load
        heading={lm.calculator.heading}
        flightTo={lm.calculator.flightTo}
        miles={lm.calculator.miles}
        near={lm.calculator.near}
        far={lm.calculator.far}
        currency={lm.calculator.currency}
        motoristText={lm.calculator.motoristText}
      />

    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="border-t border-zinc-800"></div>
    </div>

    <!-- FAQ Section -->
    <section id="faq" class="py-20 px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-bold text-center mb-12 text-white">
          {lm.faq.heading}
        </h2>
        <div class="space-y-4">

          <!-- FAQ 1 -->
          <details class="group bg-white/5 rounded-lg overflow-hidden border border-zinc-800 hover:border-brand-pink/50 transition-colors">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold text-white hover:bg-white/5 transition-colors">
              <span class="text-lg">{lm.faq.q1}</span>
              <ChevronDown class="w-5 h-5 text-pink-400 group-open:rotate-180 transition-transform shrink-0 ml-4" />
            </summary>
            <div class="px-6 pb-6 text-zinc-400 leading-relaxed">
              <ul class="list-disc pl-5 space-y-2">
                {lm.faq.a1Bullets.map((item) => <li>{item}</li>)}
                <li>
                  {lm.faq.a1CoalitionJoin}{" "}
                  <a
                    href={lm.faq.a1CoalitionHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-pink-400 hover:text-pink-300 underline"
                  >
                    {lm.faq.a1CoalitionText}
                  </a>.
                </li>
              </ul>
            </div>
          </details>

          <!-- FAQ 2 -->
          <details class="group bg-white/5 rounded-lg overflow-hidden border border-zinc-800 hover:border-brand-pink/50 transition-colors">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold text-white hover:bg-white/5 transition-colors">
              <span class="text-lg">{lm.faq.q2}</span>
              <ChevronDown class="w-5 h-5 text-pink-400 group-open:rotate-180 transition-transform shrink-0 ml-4" />
            </summary>
            <div class="px-6 pb-6 text-zinc-400 leading-relaxed space-y-3">
              <p>
                {lm.faq.a2p1Before}
                <strong class="text-pink-400">{lm.faq.a2p1Emphasis}</strong>
                {lm.faq.a2p1After}
              </p>
              <p>{lm.faq.a2p2}</p>
              <p>
                {lm.faq.a2p3Before}
                <a
                  href={lm.faq.a2p3Href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-pink-400 hover:text-pink-300 underline"
                >
                  {lm.faq.a2p3LinkText}
                </a>
                {lm.faq.a2p3After}
              </p>
              <p>
                {lm.faq.a2p4Before}
                <a
                  href={lm.faq.a2p4Href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-pink-400 hover:text-pink-300 underline"
                >
                  {lm.faq.a2p4LinkText}
                </a>
                {lm.faq.a2p4After}
              </p>
            </div>
          </details>

          <!-- FAQ 3 -->
          <details class="group bg-white/5 rounded-lg overflow-hidden border border-zinc-800 hover:border-brand-pink/50 transition-colors">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold text-white hover:bg-white/5 transition-colors">
              <span class="text-lg">{lm.faq.q3}</span>
              <ChevronDown class="w-5 h-5 text-pink-400 group-open:rotate-180 transition-transform shrink-0 ml-4" />
            </summary>
            <div class="px-6 pb-6 text-zinc-400 leading-relaxed space-y-3">
              <p>{lm.faq.a3p1}</p>
              <p>{lm.faq.a3p2}</p>
              <p>
                {lm.faq.a3p3Before}
                <a
                  href={lm.faq.a3p3Href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-pink-400 hover:text-pink-300 underline"
                >
                  {lm.faq.a3p3LinkText}
                </a>
                {lm.faq.a3p3After}
              </p>
              <p>
                {lm.faq.a3p4Before}
                <a
                  href={lm.faq.a3p4Link1Href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-pink-400 hover:text-pink-300 underline"
                >
                  {lm.faq.a3p4Link1Text}
                </a>
                {lm.faq.a3p4Mid}
                <a
                  href={lm.faq.a3p4Link2Href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-pink-400 hover:text-pink-300 underline"
                >
                  {lm.faq.a3p4Link2Text}
                </a>
                {lm.faq.a3p4After}
              </p>
              <p>{lm.faq.a3p5}</p>
            </div>
          </details>

          <!-- FAQ 4 -->
          <details class="group bg-white/5 rounded-lg overflow-hidden border border-zinc-800 hover:border-brand-pink/50 transition-colors">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold text-white hover:bg-white/5 transition-colors">
              <span class="text-lg">{lm.faq.q4}</span>
              <ChevronDown class="w-5 h-5 text-pink-400 group-open:rotate-180 transition-transform shrink-0 ml-4" />
            </summary>
            <div class="px-6 pb-6 text-zinc-400 leading-relaxed space-y-3">
              <p>{lm.faq.a4p1}</p>
              <p>{lm.faq.a4p2}</p>
              <p>{lm.faq.a4p3}</p>
            </div>
          </details>

          <!-- FAQ 5 -->
          <details class="group bg-white/5 rounded-lg overflow-hidden border border-zinc-800 hover:border-brand-pink/50 transition-colors">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold text-white hover:bg-white/5 transition-colors">
              <span class="text-lg">{lm.faq.q5}</span>
              <ChevronDown class="w-5 h-5 text-pink-400 group-open:rotate-180 transition-transform shrink-0 ml-4" />
            </summary>
            <div class="px-6 pb-6 text-zinc-400 leading-relaxed space-y-3">
              <p>{lm.faq.a5p1}</p>
              <p>{lm.faq.a5p2}</p>
            </div>
          </details>

          <!-- FAQ 6 -->
          <details class="group bg-white/5 rounded-lg overflow-hidden border border-zinc-800 hover:border-brand-pink/50 transition-colors">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold text-white hover:bg-white/5 transition-colors">
              <span class="text-lg">{lm.faq.q6}</span>
              <ChevronDown class="w-5 h-5 text-pink-400 group-open:rotate-180 transition-transform shrink-0 ml-4" />
            </summary>
            <div class="px-6 pb-6 text-zinc-400 leading-relaxed space-y-3">
              <p>{lm.faq.a6p1}</p>
              <p>{lm.faq.a6p2}</p>
            </div>
          </details>

        </div>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="border-t border-zinc-800"></div>
    </div>

    <!-- Campaigns Section -->
    <section id="campaigns" class="py-20 px-6 lg:px-8">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-center mb-12 text-white">
          {lm.campaigns.heading}
        </h2>
        <div class="flex justify-center">
          <a
            href={homeHref}
            class="group bg-white/5 rounded-lg overflow-hidden border border-zinc-800 hover:border-brand-pink/50 transition-all p-8 max-w-md flex-1"
          >
            <div class="flex items-center justify-center mb-4 h-32">
              <img src={jetrolLogoWhite.src} alt="Jetrol" class="h-20 w-auto" />
            </div>
            <p class="text-center text-zinc-400 group-hover:text-white transition-colors">
              {lm.campaigns.jetrolText}
            </p>
          </a>
        </div>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="border-t border-zinc-800"></div>
    </div>

    <!-- Footer -->
    <footer class="py-12 px-6 lg:px-8 bg-zinc-900">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col items-center text-center space-y-4">
          <a href={learnMoreHref} class="inline-block transition-opacity">
            <img
              src={jetcollectorsLogo.src}
              alt="Jet Collectors"
              class="h-16 w-auto brightness-0 invert"
            />
          </a>
        </div>
      </div>
    </footer>
  </main>
</Layout>
