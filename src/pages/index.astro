---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import jetrolLogoWhite from "../assets/jetrol/Jetrol-Logo-White.svg";
import jetrolLogoBlue from "../assets/jetrol/Jetrol-Logo-Blue.svg";
import jetcollectorsLogo from "../assets/JetCollectors_logo-1.svg";
import jetsetHero from "../assets/jetset-hero.jpg";

const petitionUrl = "https://action.wearepossible.org/page/180469/action/1";
const learnMoreHref = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/learnmore`;
---

<Layout
	title="Jetrol - Duty free petrol"
	description="Private jets don't pay duty on fuel. Jetrol is a duty-free petrol available for any winged vehicle."
>
	<main class="bg-[#253370] text-white overflow-x-hidden">
		<!-- Hero: logo as hero, shooting star draws in -->
		<section
			class="min-h-[100svh] md:min-h-[960px] flex flex-col px-6 pt-6 pb-16 md:px-20 md:pt-10 md:pb-20"
		>
			<nav
				class="flex justify-end items-center gap-6 md:gap-10 text-xs md:text-base tracking-[0.2em]"
			>
				<a href="#prices" class="hidden sm:inline hover:text-[#F16423]"
					>PRICES</a
				>
				<a href="#jetrofit" class="hidden sm:inline hover:text-[#F16423]"
					>JETRO-FITTING</a
				>
				<a
					href={petitionUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center min-h-12 px-6 border border-white rounded-full hover:text-[#F16423] hover:border-[#F16423]"
					>JOIN THE CAMPAIGN</a
				>
			</nav>
			<div
				class="grow flex flex-col items-center justify-center gap-10 md:gap-14"
			>
				<h1 class="m-0">
					<img
						src={jetrolLogoWhite.src}
						alt="Jetrol"
						class="jt-logo block w-[min(780px,88vw)] h-auto"
					/>
				</h1>
				<p
					class="jt-strap m-0 text-lg sm:text-3xl md:text-[46px] font-light tracking-[0.62em] -mr-[0.62em]"
				>
					DUTY FREE PETROL
				</p>
				<svg
					viewBox="0 0 320 110"
					class="block w-[220px] md:w-[320px] h-auto"
					fill="none"
					stroke="#ffffff"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<path
						class="jt-trail"
						pathLength="1"
						d="M6 104C70 56 160 26 262 22"
						stroke-width="1.3"></path>
					<path
						class="jt-star"
						d="M280 4V40M262 22H298M268 10L292 34M292 10L268 34"
						stroke-width="1.6"></path>
				</svg>
			</div>
		</section>

		<!-- About: tilted headline on orange -->
		<section
			id="about"
			class="bg-[#F16423] text-[#1b2552] px-6 py-20 md:px-20 md:pt-[130px] md:pb-[110px] overflow-hidden"
		>
			<div class="max-w-[1280px] mx-auto">
				<div class="flex flex-col gap-3 md:gap-[18px] md:-rotate-[5deg] md:origin-left"
					data-reveal
				>
					<h2
						class="m-0 text-white font-extrabold italic leading-[0.92] tracking-[-0.025em] text-[clamp(56px,11vw,160px)]"
					>
						PAY TAX LIKE<br />A BILLIONAIRE.
					</h2>
					<svg
						viewBox="0 0 1000 40"
						class="jt-underline block w-full max-w-[1080px] h-auto md:ml-[30px]"
						aria-hidden="true"
						><path
							fill="#253370"
							d="M20 0H1000L993 40H20A20 20 0 0 1 20 0Z"></path></svg
					>
				</div>
				<div
					class="mt-16 md:mt-[110px] flex flex-col md:flex-row md:items-center justify-between gap-10 md:gap-16"
				>
					<p
						class="m-0 max-w-[860px] text-2xl sm:text-4xl lg:text-[50px] leading-[1.2] font-light tracking-[-0.01em]"
					>
						Did you know private jets don’t pay duty on fuel? <strong
							class="font-extrabold italic"
							>Jetrol is a duty-free petrol available for any
							winged vehicle.</strong
						>
					</p>
					<svg
						viewBox="0 0 240 124"
						class="block w-[220px] md:w-[340px] h-auto shrink-0"
						fill="none"
						stroke="#253370"
						stroke-width="4"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
						><path d="M4 114H236"></path><rect
							x="12"
							y="16"
							width="40"
							height="98"
							rx="5"></rect><rect
							x="20"
							y="26"
							width="24"
							height="18"
							rx="2"></rect><path d="M20 56H44"></path><path
							d="M52 34C74 34 74 80 90 92"></path><path
							d="M86 88L96 98"></path><path d="M100 44L124 74"
						></path><path d="M220 44L196 74"></path><path
							d="M140 50H180L188 68H132Z"></path><rect
							x="122"
							y="68"
							width="76"
							height="28"
							rx="6"></rect><path d="M132 96V108M188 96V108"
						></path><circle cx="134" cy="81" r="4"></circle><circle
							cx="186"
							cy="81"
							r="4"></circle></svg
					>
				</div>
			</div>
		</section>

		<!-- Prices: pump-sign comparison -->
		<section
			id="prices"
			class="bg-[#1e2a5e] px-6 py-20 md:px-20 md:py-[120px] flex justify-center"
		>
			<div
				class="flex flex-col md:flex-row items-center gap-8 md:gap-14"
			>
				<div
					class="w-[min(420px,86vw)] aspect-square box-border bg-[#3a3c47] border-[6px] border-[#9a9cab] rounded-2xl overflow-hidden flex flex-col"
				>
					<div
						class="h-[28%] shrink-0 bg-[#d6d8e0] text-[#2b2d36] flex items-center justify-center text-4xl md:text-[52px] font-bold tracking-[0.08em]"
					>
						PETROL
					</div>
					<div
						class="grow flex flex-col items-center justify-center gap-3 px-6 py-2"
					>
						<div class="text-xs md:text-sm font-semibold tracking-[0.18em] text-[#c9cbd6]">FUEL DUTY PER LITRE</div>
						<span
							class="bg-[#111217] rounded-[10px] px-7 py-2.5 text-6xl md:text-[88px] leading-[1.1] font-bold tabular-nums"
							data-count="52.95">52.95p</span
						>
					</div>
					<div
						class="h-16 shrink-0 border-t border-[#5a5c6a] flex items-center justify-center gap-3 text-sm md:text-[15px] tracking-[0.14em] text-[#c9cbd6]"
					>
						<svg
							viewBox="0 0 64 40"
							class="block w-9 h-auto"
							fill="none"
							stroke="currentColor"
							stroke-width="3"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							><path d="M22 8H42L46 18H18Z"></path><rect
								x="14"
								y="18"
								width="36"
								height="14"
								rx="3"></rect><path d="M19 32v5M45 32v5"
							></path></svg
						>
						WINGLESS VEHICLES
					</div>
				</div>

				<div class="text-xl font-light tracking-[0.3em] text-[#b9c1e6]">
					VS
				</div>

				<div
					class="w-[min(420px,86vw)] aspect-square box-border bg-[#253370] border-[6px] border-white rounded-2xl overflow-hidden flex flex-col"
				>
					<div
						class="h-[28%] shrink-0 bg-white flex items-center justify-center"
					>
						<img
							src={jetrolLogoBlue.src}
							alt="Jetrol"
							class="block w-[52%] h-auto"
						/>
					</div>
					<div
						class="grow flex flex-col items-center justify-center gap-3 px-6 py-2"
					>
						<div class="text-xs md:text-sm font-semibold tracking-[0.18em] text-[#b9c1e6]">FUEL DUTY PER LITRE</div>
						<span
							class="bg-[#0c0f1c] rounded-[10px] px-7 py-2.5 text-6xl md:text-[88px] leading-[1.1] font-bold text-[#F16423] tabular-nums"
							data-count="0.00">0.00p</span
						>
					</div>
					<div
						class="h-16 shrink-0 border-t border-[#3a4680] flex items-center justify-center gap-3 text-sm md:text-[15px] tracking-[0.14em]"
					>
						<svg
							viewBox="0 0 64 40"
							class="block w-9 h-auto"
							fill="none"
							stroke="currentColor"
							stroke-width="3"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							><path d="M2 10L17 21"></path><path d="M62 10L47 21"
							></path><path d="M22 8H42L46 18H18Z"></path><rect
								x="14"
								y="18"
								width="36"
								height="14"
								rx="3"></rect><path d="M19 32v5M45 32v5"
							></path></svg
						>
						WINGED VEHICLES &amp; JETS
					</div>
				</div>
			</div>
		</section>

		<!-- Jetro-fitting: Jetset cross-sell -->
		<section
			id="jetrofit"
			class="bg-white text-[#1b2552] px-6 py-20 md:px-20 md:py-[100px]"
		>
			<div
				class="max-w-[1280px] mx-auto flex flex-col lg:flex-row items-center gap-12 lg:gap-20"
			>
				<Image
					src={jetsetHero}
					alt="A red hatchback fitted with cardboard wings, beside a chauffeur and a flat-pack Jetset box"
					widths={[640, 960, 1280]}
					sizes="(min-width: 1024px) 640px, 100vw"
					class="block w-full lg:w-[48%] lg:max-w-[640px] aspect-[4/3] object-cover rounded-[10px] shrink-0"
				/>
				<div class="grow flex flex-col gap-7">
					<h2
						class="m-0 text-5xl sm:text-7xl lg:text-[clamp(56px,5vw,80px)] lg:whitespace-nowrap leading-[0.95] font-extrabold italic tracking-[-0.025em] text-[#253370]"
					>
						No wings?<br /><span class="text-[#F16423]"
							>No problem.</span
						>
					</h2>
					<p class="m-0 text-xl md:text-[30px] leading-[1.4]">
						Try <strong class="font-extrabold italic">Jetset</strong
						>, a set of wings you can assemble yourself.
					</p>
					<div class="flex mt-2">
						<a
							href="https://jetsetset.com"
							class="inline-flex items-center min-h-16 px-9 rounded-full bg-[#253370] text-white text-[17px] font-medium tracking-[0.2em] hover:bg-[#F16423] hover:text-[#1b2552]"
							>GET JETSET</a
						>
					</div>
				</div>
			</div>
		</section>

		<!-- Campaign call to action -->
		<section
			id="join"
			class="bg-[#253370] px-6 py-20 md:px-20 md:py-[120px] flex flex-col items-center justify-center gap-10 text-center"
		>
			<svg
				viewBox="0 0 64 40"
				class="block w-[120px] md:w-[150px] h-auto"
				fill="none"
				stroke="#ffffff"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
				><path d="M2 10L17 21"></path><path d="M62 10L47 21"></path><path
					d="M22 8H42L46 18H18Z"></path><rect
					x="14"
					y="18"
					width="36"
					height="14"
					rx="3"></rect><path d="M19 32v5M45 32v5"></path></svg
			>
			<h2
				class="m-0 text-4xl md:text-[72px] leading-[1.02] italic tracking-[-0.025em]"
			>
				<span class="block font-light">You pay fuel duty.</span>
				<span class="block font-extrabold text-[#F16423]"
					>Why don't billionaires?</span
				>
			</h2>
			<p class="m-0 text-lg md:text-[25px]">
				Join the campaign for fairer taxes on private jet fuel.
			</p>
			<div class="flex flex-col sm:flex-row gap-5 items-center">
				<a
					href={petitionUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center justify-center min-h-16 px-10 rounded-full bg-[#F16423] text-[#1b2552] text-[17px] font-medium tracking-[0.2em] hover:bg-white"
					>JOIN THE CAMPAIGN</a
				>
				<a
					href={learnMoreHref}
					class="inline-flex items-center justify-center min-h-16 px-10 rounded-full border-2 border-white text-[17px] font-medium tracking-[0.2em] hover:text-[#F16423] hover:border-[#F16423]"
					>LEARN MORE</a
				>
			</div>
		</section>

		<!-- Credits -->
		<footer
			class="bg-[#1b2552] px-6 py-12 md:px-20 flex flex-col sm:flex-row items-center justify-between gap-8"
		>
			<a href={learnMoreHref} class="block hover:opacity-80">
				<img
					src={jetcollectorsLogo.src}
					alt="Jet Collectors"
					class="block w-[180px] h-auto invert"
				/>
			</a>
			<a
				href="https://seriouspeople.co"
				class="text-[13px] tracking-[0.2em] font-medium text-[#b9c1e6] hover:text-white"
				>MADE BY SERIOUS PEOPLE</a
			>
		</footer>
	</main>
</Layout>

<script>
	// Reveal on scroll: adds .is-in once, and counts [data-count] prices up from zero.
	const reduceMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;

	const countUp = (el: HTMLElement) => {
		const target = parseFloat(el.dataset.count ?? "0");
		const duration = 1400;
		const start = performance.now();
		const tick = (now: number) => {
			const t = Math.min((now - start) / duration, 1);
			const eased = 1 - Math.pow(1 - t, 3);
			el.textContent = `${(target * eased).toFixed(2)}p`;
			if (t < 1) requestAnimationFrame(tick);
		};
		requestAnimationFrame(tick);
	};

	if (!reduceMotion && "IntersectionObserver" in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					const el = entry.target as HTMLElement;
					el.classList.add("is-in");
					if (el.dataset.count !== undefined) countUp(el);
					observer.unobserve(el);
				}
			},
			{ threshold: 0.6 },
		);
		document
			.querySelectorAll<HTMLElement>("[data-reveal], [data-count]")
			.forEach((el) => {
				el.classList.add("will-reveal");
				if (el.dataset.count !== undefined) el.textContent = "0.00p";
				observer.observe(el);
			});
	}
</script>

<style>
	/* The underline under PAY TAX LIKE A BILLIONAIRE draws left to right when its block is revealed.
	   The trigger sits on the wrapper: a scaleX(0) element has no area for the observer to see. */
	:global(.will-reveal .jt-underline) {
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 0.9s cubic-bezier(0.3, 0, 0.2, 1) 0.15s;
	}
	:global(.will-reveal.is-in .jt-underline) {
		transform: scaleX(1);
	}
</style>

<style>
	/* Hero intro from D2: trail draws, star bursts, logo then strapline fade up. Plays once. */
	.jt-trail {
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		animation: jt-draw 1.1s cubic-bezier(0.3, 0, 0.2, 1) 0.3s forwards;
	}
	.jt-star {
		opacity: 0;
		transform-box: fill-box;
		transform-origin: center;
		animation: jt-burst 0.7s ease-out 1.25s forwards;
	}
	.jt-logo {
		opacity: 0;
		animation: jt-fade 1.2s ease-out 1.6s forwards;
	}
	.jt-strap {
		opacity: 0;
		animation: jt-fade 1s ease-out 2.4s forwards;
	}
	@keyframes jt-draw {
		to {
			stroke-dashoffset: 0;
		}
	}
	@keyframes jt-burst {
		0% {
			opacity: 0;
			transform: scale(0.2) rotate(-45deg);
		}
		60% {
			opacity: 1;
			transform: scale(1.35) rotate(0);
		}
		100% {
			opacity: 1;
			transform: scale(1) rotate(0);
		}
	}
	@keyframes jt-fade {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.jt-trail,
		.jt-star,
		.jt-logo,
		.jt-strap {
			animation: none;
			opacity: 1;
			stroke-dashoffset: 0;
		}
	}
</style>
